      "label": "Chief Sales Officer",
      "level": 2,
      "reportsTo": "ca:post/jupiter-ceo",
      "heldBy": "ca:person/jupiter-cso"
    }
  ],

  "people": [
    {
      "@id": "ca:person/jupiter-ceo",
      "@type": "prov:Person",
      "alias": "Jupiter_Chief_Executive_Officer",
