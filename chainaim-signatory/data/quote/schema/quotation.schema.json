{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "chainaim-signatory/data/quote/schema/quotation.schema.json",
  "title": "Quotation (ERPNext shape) — jupiterSellerAgent to tommyBuyerAgent",
  "description": "Field names follow the official ERPNext doctypes 'Quotation', 'Quotation Item' and 'Payment Schedule' (github.com/frappe/erpnext, develop branch, read 2026-11-14). ERPNext 'rate' and 'amount' are in currency units (USD), so custom_rate_cents carries the exact cents. ERPNext Quotation Item has no delivery-date field, so the delivery plan is in custom_delivery_date and custom_shipments. Fields prefixed custom_ are ERPNext Custom Fields.",
  "type": "object",
  "required": ["doctype", "name", "quotation_to", "party_name", "transaction_date", "order_type", "company", "currency", "conversion_rate", "selling_price_list", "plc_conversion_rate", "items", "custom_rfq", "custom_round", "custom_decision", "custom_from_agent", "custom_message_to_buyer"],
  "properties": {
    "doctype": { "const": "Quotation" },
    "name": { "type": "string", "pattern": "^QTN-[A-Z0-9-]+$" },
    "naming_series": { "type": "string" },
    "quotation_to": { "const": "Customer" },
    "party_name": { "type": "string", "minLength": 1 },
    "transaction_date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "order_type": { "const": "Sales" },
    "company": { "type": "string", "minLength": 1 },
    "currency": { "const": "USD" },
    "conversion_rate": { "type": "number" },
    "selling_price_list": { "type": "string" },
    "price_list_currency": { "type": "string" },
    "plc_conversion_rate": { "type": "number" },
    "incoterm": { "type": "string" },
    "named_place": { "type": "string" },
    "status": { "type": "string", "enum": ["Draft", "Open", "Lost"] },
    "order_lost_reason": { "type": "string" },
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "object",
        "required": ["item_code", "item_name", "qty", "uom", "conversion_factor", "rate", "amount", "custom_rate_cents", "custom_delivery_date", "custom_shipments", "prevdoc_doctype", "prevdoc_docname"],
        "properties": {
          "item_code": { "type": "string", "minLength": 1 },
          "item_name": { "type": "string" },
          "qty": { "type": "integer", "exclusiveMinimum": 0 },
          "uom": { "type": "string" },
          "conversion_factor": { "type": "number" },
          "rate": { "type": "number", "exclusiveMinimum": 0 },
          "amount": { "type": "number", "exclusiveMinimum": 0 },
          "custom_rate_cents": { "type": "integer", "exclusiveMinimum": 0 },
          "custom_delivery_date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "custom_shipments": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["units", "delivered_by"],
              "properties": {
                "units": { "type": "integer", "exclusiveMinimum": 0 },
                "delivered_by": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
              }
            }
          },
          "prevdoc_doctype": { "const": "Request for Quotation" },
          "prevdoc_docname": { "type": "string" }
        }
      }
    },
    "payment_schedule": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["due_date", "invoice_portion", "payment_amount"],
        "properties": {
          "description": { "type": "string" },
          "due_date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "invoice_portion": { "type": "number", "minimum": 0, "maximum": 100 },
          "payment_amount": { "type": "number", "minimum": 0 }
        }
      }
    },
    "custom_rfq": { "type": "string" },
    "custom_round": { "type": "integer", "minimum": 0 },
    "custom_decision": { "type": "string", "enum": ["ACCEPT", "COUNTER", "DECLINE"] },
    "custom_from_agent": { "type": "string" },
    "custom_decided_by": { "type": "string" },
    "custom_counters": { "type": "array", "items": { "type": "string" } },
    "custom_message_to_buyer": { "type": "string" }
  }
}
