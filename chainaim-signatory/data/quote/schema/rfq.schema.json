{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "chainaim-signatory/data/quote/schema/rfq.schema.json",
  "title": "Request for Quotation (ERPNext shape) — tommyBuyerAgent to jupiterSellerAgent",
  "description": "Field names follow the official ERPNext doctypes 'Request for Quotation', 'Request for Quotation Item' and 'Request for Quotation Supplier' (github.com/frappe/erpnext, develop branch, read 2026-11-14). Fields prefixed custom_ are ERPNext Custom Fields added for the agent flow (ERPNext's own convention). Only the fields this flow uses are listed; ERPNext-required fields are required here too.",
  "type": "object",
  "required": ["doctype", "name", "naming_series", "company", "transaction_date", "schedule_date", "suppliers", "items", "custom_from_agent", "custom_from_lei", "custom_to_agent", "custom_to_lei", "custom_payment_terms_days", "custom_advance_pct"],
  "properties": {
    "doctype": { "const": "Request for Quotation" },
    "name": { "type": "string", "pattern": "^RFQ-[A-Z0-9-]+$" },
    "naming_series": { "type": "string" },
    "company": { "type": "string", "minLength": 1 },
    "transaction_date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "schedule_date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "suppliers": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "object", "required": ["supplier"], "properties": { "supplier": { "type": "string", "minLength": 1 } } }
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "object",
        "required": ["item_code", "qty", "uom", "stock_uom", "conversion_factor", "schedule_date", "custom_quality_grade", "custom_target_rate_cents"],
        "properties": {
          "item_code": { "type": "string", "minLength": 1 },
          "item_name": { "type": "string" },
          "description": { "type": "string" },
          "qty": { "type": "integer", "exclusiveMinimum": 0 },
          "uom": { "type": "string" },
          "stock_uom": { "type": "string" },
          "conversion_factor": { "type": "number", "exclusiveMinimum": 0 },
          "schedule_date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "custom_quality_grade": { "type": "string", "enum": ["A", "B"] },
          "custom_target_rate_cents": { "type": "integer", "exclusiveMinimum": 0 }
        }
      }
    },
    "incoterm": { "type": "string" },
    "named_place": { "type": "string" },
    "custom_from_agent": { "type": "string" },
    "custom_from_lei": { "type": "string", "pattern": "^[A-Z0-9]{20}$" },
    "custom_to_agent": { "type": "string" },
    "custom_to_lei": { "type": "string", "pattern": "^[A-Z0-9]{20}$" },
    "custom_payment_terms_days": { "type": "integer", "minimum": 0 },
    "custom_advance_pct": { "type": "integer", "minimum": 0, "maximum": 100 }
  }
}
