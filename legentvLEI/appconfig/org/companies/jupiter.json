        "validUntil": "2027-11-12T00:00:00Z",
        "may_act": []
      },
      "escalatesTo": "ca:person/jupiter-ceo",
      "timeout": "PT24H",
      "card": {
        "name": "Jupiter CEO Agent",
        "description": "AI agent acting on behalf of the Chief Executive Officer of JUPITER KNITTING COMPANY (Level 1 OOR holder).",
        "skills": []
      }
    },
    {
      "@id": "ca:agent/jupiterSellerAgent",
      "@type": "prov:SoftwareAgent",
      "alias": "jupiterSellerAgent",
      "agentType": "AI",
      "tradeRole": "seller",
      "actedOnBehalfOf": "ca:person/jupiter-cso",
