      "advisoryOnly": true,
      "mandate": {
        "authorization_details": [
          {
            "type": "treasury_operations",
            "actions": ["cash_flow_validation", "minimum_price_advisory"]
          }
        ],
        "validUntil": "2027-11-12T00:00:00Z",
        "may_act": []
      }
    },
    {
      "@id": "ca:agent/JupiterInventoryAgent",
      "@type": "prov:SoftwareAgent",
      "alias": "JupiterInventoryAgent",
      "agentType": "AI",
      "actedOnBehalfOf": "ca:agent/jupiterSellerAgent",
      "description": "Sub-delegated advisory agent for stock and delivery checks (no payment authority)",
      "advisoryOnly": true,
      "mandate": {
        "authorization_details": [
          {
            "type": "inventory_operations",
            "actions": ["stock_check", "delivery_feasibility"]
          }
        ],
        "validUntil": "2027-11-12T00:00:00Z",
        "may_act": []
      },
      "card": {
        "name": "Jupiter Inventory Agent",
        "description": "Advisory AI agent for JUPITER KNITTING COMPANY, sub-delegated by jupiterSellerAgent. Answers stock and delivery-feasibility questions for a proposed order. It has no payment or signing authority.",
        "url": null,
        "officialRole": "Partner",
        "engagementRole": "Inventory Agent",
        "skills": [
          {
            "id": "stock_check",
            "name": "Stock Check",
            "description": "Reports whether the requested quantity can be supplied from stock for a proposed order.",
            "tags": ["inventory", "stock", "advisory"]
          },
          {
            "id": "delivery_feasibility",
            "name": "Delivery Feasibility",
            "description": "Reports whether the requested delivery date can be met for a proposed order.",
            "tags": ["inventory", "delivery", "advisory"]
          }
        ]
      }
    }
  ]
